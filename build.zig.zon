.{
    .name = .attaract,
    .version = "0.1.0",

    // Zig는 릴리스마다 API가 깨진다. 버전을 명시적으로 고정해두고,
    // 올릴 때는 마일스톤 사이에 별도 브랜치에서 몰아서 처리한다.
    .minimum_zig_version = "0.16.0",

    // fingerprint는 프로젝트 고유 ID다. 아래 값이 틀리면
    // zig build가 "올바른 값은 0x... 입니다" 라고 알려주니 그대로 복사하면 된다.
    .fingerprint = 0xc43ede1ffe21239a,

    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
    },
}
